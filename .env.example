# ============================================================
# Chat de Compras · Administrador
# ============================================================
# Copia este archivo como `.env` (está ignorado por git) y completa
# los valores de tu proyecto InsForge.
#
# Sin las dos primeras variables, el panel arranca en MODO DEMOSTRACIÓN:
# cuentas, invitaciones, compradores, comercios, documentos, categorías,
# solicitudes, ofertas, pedidos, entregas, incidencias, evidencias y auditoría
# se guardan en localStorage y NO representan datos reales.
#
# Solo se exponen valores públicos. NUNCA pongas aquí el API Key
# de administrador (ik_...), contraseñas, SMTP ni secretos.

VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=

# Bucket privado de documentos de comercios (Fase 2).
# Debe existir en InsForge Storage con acceso privado. Si se omite,
# la aplicación espera el nombre `commerce-documents`.
# Las URLs firmadas se generan solo después de que la función
# admin_document_storage_path() autorice el documento.
VITE_INSFORGE_DOCUMENTS_BUCKET=commerce-documents

# Bucket privado de evidencias de entrega (Fase 3).
# Debe existir en InsForge Storage con acceso privado. Si se omite,
# la aplicación espera el nombre `delivery-evidence`.
# Las URLs firmadas se generan solo después de que la función
# admin_delivery_evidence_path() autorice la evidencia.
VITE_INSFORGE_EVIDENCE_BUCKET=delivery-evidence
